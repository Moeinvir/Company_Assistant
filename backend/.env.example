# اتصال Postgres.
#
# پورت بستگی دارد به اینکه کدام compose را اجرا می‌کنید:
#   • docker compose up -d postgres        (از ریشهٔ پروژه) → میزبان 5432  ← پیش‌فرض
#   • docker compose up -d postgres        (از پوشهٔ backend) → میزبان 5433
# docs/DEPLOYMENT.md و README ریشه هر دو روی 5432 تنظیم شده‌اند، پس اگر مسیر
# پیشنهادی README را دنبال می‌کنید همین مقدار درست است. اگر فقط سرویس Postgres
# داخل backend/docker-compose.yml را بالا آورده‌اید، 5432 را به 5433 تغییر دهید.
DATABASE_URL="postgresql://pyre:pyre@localhost:5432/pyre?schema=public"
JWT_SECRET="replace-this-with-a-long-random-secret-at-least-32-chars"
PROVIDER_KEYS_ENCRYPTION_SECRET="replace-this-with-a-different-long-random-secret"

# پورت API. همیشه 3000 بمونه تا با فرانت هماهنگ باشه.
# API_PORT بر PORT اولویت دارد؛ این عمدی است چون بعضی لانچرها PORT=0 را export
# می‌کنند و در آن حالت Node یک پورت تصادفی می‌گیرد در حالی که فرانت همچنان 3000
# را صدا می‌زند (نتیجه: "Failed to fetch").
PORT=3000
API_PORT=3000

# پورت‌های مجاز فرانت: Vite dev = 5273 ، Docker = 8080
WEB_ORIGIN="http://localhost:5273,http://localhost:8080"
APP_URL="http://localhost:3000"
