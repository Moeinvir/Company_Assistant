DATABASE_URL="postgresql://pyre:pyre@localhost:5433/pyre?schema=public"
JWT_SECRET="replace-this-with-a-long-random-secret"
PROVIDER_KEYS_ENCRYPTION_SECRET="replace-this-with-a-different-long-random-secret"
# Listen port for the API. A value already exported by the host wins over this
# file (dotenv never overrides an existing variable) — some launchers export
# PORT=0, which would ask Node for a *random* port, so a non-numeric or
# non-positive PORT is ignored and 3000 is used instead.
PORT=3000
# Optional, and it always wins — use it to pin the port in this file even when
# the host exports PORT. Remember to point VITE_PYRE_API_URL at the same port.
# API_PORT=3000
# Comma-separated list of browser origins allowed to call this API (CORS).
# The Vite dev server is 5273, the Docker frontend is 8080.
WEB_ORIGIN="http://localhost:5273,http://localhost:5173,http://localhost:8080"
# Public address of this API; used as OpenRouter's attribution header.
APP_URL="http://localhost:3000"
