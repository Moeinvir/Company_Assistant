# Copy to .env and fill in. Secrets must be ≥32 random characters each.
# Generate e.g. with:  openssl rand -hex 32

# Postgres password used by the container and the API connection string
POSTGRES_PASSWORD=pyre

# Auth + provider-key encryption secrets (change these!)
JWT_SECRET=replace-with-openssl-rand-hex-32
PROVIDER_KEYS_ENCRYPTION_SECRET=replace-with-openssl-rand-hex-32-different

# CORS origins allowed to call the API
WEB_ORIGIN=http://localhost:8080

# Baked into the frontend image at build time
VITE_PYRE_API_URL=http://localhost:3000
