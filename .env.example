# Point the frontend at the platform API. With this set, provider keys live on
# the server and every provider call is proxied through the API (no browser
# CORS, no key in the browser).
#
# The port must match the API's actual listen port (see the “API listening on
# http://localhost:3000” line in the backend log; `PORT` in backend/.env,
# default 3000 — a host-level PORT such as PORT=0 is ignored).
VITE_PYRE_API_URL=http://localhost:3000

# Leave it unset to run the offline demo data layer: the whole dataset and the
# provider keys stay in this browser (localStorage) and provider calls go
# straight from the browser to the vendor.
